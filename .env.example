# Application Configuration
FLASK_ENV=development
PORT=5000

# MongoDB Configuration
# For Docker Compose replica set:
MONGO_URI=mongodb://mongo:27017/ecommerce_db?replicaSet=rs0&directConnection=true
DB_NAME=ecommerce_db

# For Local Development / Standalone MongoDB:
# MONGO_URI=mongodb://localhost:27017/ecommerce_db
# DB_NAME=ecommerce_db

# Test Database Configuration
TEST_MONGO_URI=mongodb://localhost:27017/ecommerce_test_db?replicaSet=rs0&directConnection=true
TEST_DB_NAME=ecommerce_test_db
