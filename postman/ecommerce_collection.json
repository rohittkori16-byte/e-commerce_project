            "url": {
              "raw": "{{base_url}}/api/baskets/{{shopper_id}}/items",
              "host": ["{{base_url}}"],
              "path": ["api", "baskets", "{{shopper_id}}", "items"]
            }
          }
        },
        {
          "name": "Step 10 - Review Basket with Totals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/baskets/{{shopper_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "baskets", "{{shopper_id}}"]
            }
          }
        },
        {
          "name": "Step 11 - Change Mouse Quantity in Basket",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
