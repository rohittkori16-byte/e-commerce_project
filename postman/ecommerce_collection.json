            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/baskets/{{shopper_id}}/items/{{mouse_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "baskets", "{{shopper_id}}", "items", "{{mouse_id}}"]
            }
          }
        },
        {
          "name": "Step 12 - Attempt Over-Purchase Checkout (Expect 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/checkout/{{shopper_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "checkout", "{{shopper_id}}"]
            }
          }
        },
        {
          "name": "Step 13 - Verify Failed Checkout Did Not Change Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/{{mouse_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{mouse_id}}"]
            }
          }
        },
        {
          "name": "Step 14 - Adjust Quantity & Perform Successful Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.order && jsonData.order.order_id) {",
                  "    pm.collectionVariables.set('order_id', jsonData.order.order_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/checkout/{{shopper_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "checkout", "{{shopper_id}}"]
            }
          }
        },
        {
          "name": "Step 15 - Verify Remaining Product Stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/{{mouse_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{mouse_id}}"]
            }
          }
        },
        {
          "name": "Step 16 - Verify Basket is Now Empty",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/baskets/{{shopper_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "baskets", "{{shopper_id}}"]
            }
          }
        },
        {
          "name": "Step 17 - Retrieve Completed Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "{{order_id}}"]
            }
          }
        }
      ]
    },
